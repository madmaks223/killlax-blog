---
import '../styles/global.css';
import { basePath, siteConfig, withBase } from '../config';
import MatrixFlameBackground from '../components/MatrixFlameBackground.astro';

interface Props {
  title?: string;
  description?: string;
  flameBackground?: boolean;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
}

const {
  title, description = siteConfig.description, flameBackground = false,
  type = 'website', published, updated, noindex = false,
  image, imageAlt,
} = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.name;
const path = Astro.url.pathname;
const sitePath = path.startsWith(basePath) ? path.slice(basePath.length) || '/' : path;
const canonicalUrl = new URL(withBase(sitePath), Astro.site ?? siteConfig.url).href;
const imageUrl = image ? new URL(withBase(image), Astro.site ?? siteConfig.url).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={flameBackground ? '#050505' : '#11110f'} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.language.replace('-', '_')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && <meta property="article:author" content={siteConfig.author} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={withBase('/rss.xml')} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'home-page': flameBackground }}>
    {flameBackground && <div class="home-background"><MatrixFlameBackground /></div>}
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={withBase('/')} aria-label="killlax 首页">killlax<span>.</span></a>
        <nav aria-label="主导航">
          <a class:list={{ active: sitePath.startsWith('/blog/') }} aria-current={sitePath.startsWith('/blog/') ? 'page' : undefined} href={withBase('/blog/')}>文章</a>
          <a class:list={{ active: sitePath === '/about/' }} aria-current={sitePath === '/about/' ? 'page' : undefined} href={withBase('/about/')}>关于</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>这里是 killlax · <a class="footer-rss" href={withBase('/rss.xml')}>RSS</a></span>
        <span>用好奇心记录世界 <i aria-hidden="true">✳</i></span>
      </footer>
    </div>
  </body>
</html>
