---
interface Props {
  mode?: 'embers' | 'soulfire' | 'reference';
}

import { withBase } from '../config';

const { mode = 'reference' } = Astro.props;
const referenceImage = withBase('/flame-preview/bonfire-embers.webp');
---

<div class="matrix-flame" data-matrix-flame data-mode={mode} style={`--reference-image: url("${referenceImage}")`} aria-hidden="true">
  <canvas data-flame-canvas></canvas>
  <div class="matrix-reference"></div>
  <canvas data-ash-canvas></canvas>
  <div class="matrix-noise"></div>
  <div class="matrix-vignette"></div>
</div>

<style>
  .matrix-flame { --reference-brightness: .8; --fire-breath: 1; position: absolute; inset: 0; z-index: -1; overflow: hidden; isolation: isolate; pointer-events: none; background: #050505; }
  canvas, .matrix-reference, .matrix-noise, .matrix-vignette { position: absolute; inset: 0; width: 100%; height: 100%; }
  [data-flame-canvas] { z-index: 0; }
  .matrix-reference { z-index: 1; opacity: 0; background: var(--reference-image) center 54% / min(100vw, 920px) auto no-repeat; filter: brightness(calc(var(--reference-brightness) * var(--fire-breath))); mix-blend-mode: screen; transition: opacity .5s ease; mask-image: radial-gradient(ellipse at center, #000 32%, transparent 76%); }
  [data-mode='reference'] .matrix-reference { opacity: .8; }
  [data-ash-canvas] { z-index: 2; opacity: 0; }
  [data-mode='reference'] [data-ash-canvas] { opacity: 1; }
  .matrix-noise { z-index: 3; opacity: .075; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.42'/%3E%3C/svg%3E"); mix-blend-mode: screen; }
  .matrix-vignette { z-index: 4; background: radial-gradient(ellipse at center, transparent 32%, rgba(0,0,0,.38) 78%, rgba(0,0,0,.85) 120%); }
  @media (max-width: 640px) {
    .matrix-reference { background-size: auto min(90svh, 720px); background-position: center 58%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .matrix-reference { transition: none; }
  }
</style>

<script>
  import { initMatrixFlame } from '../scripts/matrix-flame';

  document.querySelectorAll<HTMLElement>('[data-matrix-flame]').forEach(initMatrixFlame);
</script>
